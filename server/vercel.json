{
  "version": 2,
  "builds": [
    {
      "src": "server.cjs",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "supportsResponseStreaming": true
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.cjs"
    },
    {
      "source": "/(.*)",
      "destination": "/server.cjs"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/trial-emails",
      "schedule": "0 13 * * *"
    }
  ]
}